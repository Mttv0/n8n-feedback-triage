      "parameters": {
        "jsCode": "const item = $input.item.json;\nconst raw = item.content?.[0]?.text || item.text || item.message || '';\nconst cleaned = raw.replace(/```json/gi, '').replace(/```/g, '').trim();\n\nlet parsed;\ntry {\n  parsed = JSON.parse(cleaned);\n} catch (e) {\n  parsed = { category: 'unparsed', urgency: 'unparsed', summary: cleaned };\n}\n\nreturn { json: parsed };"
